# Darukaa.Earth AI Biodiversity Intelligence Chatbot

DATABASE_URL=postgresql+psycopg://darukaa:darukaa@localhost:5433/darukaa_ai

# LLM Provider: mock | openai | anthropic
# For Groq (OpenAI-compatible): LLM_PROVIDER=openai and set LLM_BASE_URL
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=
# Groq example:
# LLM_PROVIDER=openai
# LLM_API_KEY=gsk_...
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-20b

# Embedding Provider: mock | openai
EMBEDDING_PROVIDER=mock
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=384

CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174,http://localhost:5173,http://localhost:3000

SECRET_KEY=change-me-in-production-use-a-long-random-string

# App
APP_ENV=development
LOG_LEVEL=INFO
API_PREFIX=/api/v1

# Frontend (Vite)
VITE_API_URL=http://127.0.0.1:8001
